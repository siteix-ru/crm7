# CRM7 Dockerless VPS — server-side .env template.
#
# Copy to /srv/crm7/api/config/.env (root instance) or
# /srv/crm7/demo/api/config/.env (separate /demo/ instance).
# NEVER put this file in the web root or commit it.
# Values below are placeholders, not secrets. Generate APP_KEY and
# DB_CONFIG_KEY with: openssl rand -hex 32

APP_ENV=prod
DEMO_MODE=false
APP_URL=https://crm.example.com
CORS_ORIGIN=https://crm.example.com

# Root instance: /api/v2
# Separate /demo/ instance: /demo/api/v2
# One backend instance serves exactly one API_BASE_PATH.
API_BASE_PATH=/api/v2

# Use a TCP host. Do NOT use `localhost`: PDO MySQL treats it as a Unix socket.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=crm_prod
DB_USER=crm_app
DB_PASS=change_me

DB_ALLOW_HOST_CHANGE=false
DB_HOST_ALLOWLIST=
TOKEN_TTL_DAYS=30
APP_TIMEZONE=Europe/Moscow

# Keys (generate separately; keep only in this server-side file):
APP_KEY=replace_with_openssl_rand_hex_32
DB_CONFIG_KEY=replace_with_openssl_rand_hex_32

# Optional Excel library path (PhpSpreadsheet). Leave empty if not deployed
# or set to the absolute path of vendor/autoload.php outside the web root.
LEGACY_VENDOR=

# Logs outside the web root.
# ROOT instance:  /srv/crm7/var/log
# DEMO instance:  /srv/crm7/demo/var/log   <- override when copying this file
LOG_DIR=/srv/crm7/var/log

# Storage is api-relative by default; explicit value is allowed.
# ROOT instance:  /srv/crm7/api/storage
# DEMO instance:  /srv/crm7/demo/api/storage   <- override when copying
STORAGE_DIR=/srv/crm7/api/storage

# IMPORTANT: the values above belong to the ROOT instance. Do NOT copy them
# unchanged into /srv/crm7/demo/api/config/.env — a separate demo backend has
# its own LOG_DIR and STORAGE_DIR (see the comments above). API_BASE_PATH must
# also be changed to /demo/api/v2 for that instance.

# NOTE: backup/restore and the updater are not part of this profile; cron is configured via cron.sh.
# CRM7_UPDATE_DIR is intentionally omitted; admin update endpoints stay
# disabled until a native update profile is implemented.
