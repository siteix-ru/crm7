APP_ENV=dev
# Демо-режим: страница входа показывает учётные записи demo_* (пароль demo123456),
# часть деструктивных действий блокируется. Только для demo/dev, на k/prod — false.
DEMO_MODE=false
APP_URL=http://localhost:5173
API_BASE_PATH=/api/v2
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=crm_local
DB_USER=crm_app
DB_PASS=change_me

# Политика смены сервера БД через UI (DatabaseHostPolicy): по умолчанию запрещено.
# Текущая пара DB_HOST + DB_PORT разрешена полностью. Смена DB_PORT через UI
# запрещена всегда, в том числе при неизменном DB_HOST. Разрешение смены DB_HOST
# не даёт права менять DB_PORT: новый хост проверяется с тем же портом.
DB_ALLOW_HOST_CHANGE=false
# Точные hostname/IP через запятую (CIDR и wildcard не поддерживаются).
# Пустой список не означает разрешение произвольных адресов.
DB_HOST_ALLOWLIST=

TOKEN_TTL_DAYS=30

LOG_DIR=
APP_TIMEZONE=Europe/Moscow
APP_KEY=change_me_random_64_hex
# Ключ шифрования пароля в config/database.json (генерация: openssl rand -hex 32).
DB_CONFIG_KEY=change_me_random_64_hex
LEGACY_VENDOR=
